          "expr": "1 - (sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\",status=~\"5..\"}[1h])) / clamp_min(sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[1h])), 1e-9))",

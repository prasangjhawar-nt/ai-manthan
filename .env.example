# Copy to .env (git-ignored). Every value has a dev default in docker-compose.yml, so .env is optional.
GATEWAY_PORT=8080
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-me
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
BACKEND_REPLICAS=2
# CPU limit per backend replica (devops.md 5); raise on a bigger machine
BACKEND_CPUS=1.0
TAG=local
JWT_SECRET=dev-only-change-me-32-bytes-minimum-0001
JWT_TTL_MINUTES=60
BANK_TIMEOUT_MS=3000
PAYOUT_RETRY_INTERVAL_MS=30000
TZ=UTC
# Host port for postgres in docker-compose.dev.yml (5433 if something else uses 5432)
DEV_PG_PORT=5432
